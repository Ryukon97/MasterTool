  entries:
  - id: 0
    speakerName: "\uB098"
    dialogueText: "2020\uB144 4\uC6D44\uC77C \uB098\uB294 \uC624\uB298 \uC5B4\uBA38\uB2C8\uB97C
      \uBCF4\uB0B4\uB4DC\uB838\uB2E4"
