    EffectScale: 1
    choices: []
    nextIndexOverride: -1
  - id: 2
    speakerName: "\uB098"
    dialogueText: "\uB9C8\uC74C\uC774 \uBB34\uAC70\uC6CC\uC9C4\uB2E4 \uBC16\uC5D0
      \uB098\uAC08\uAE4C?"
    characterIllust: {fileID: 0}
    CharacterPNG: {fileID: 0}
    BackGroundSprit: {fileID: 6919469891305825980, guid: 02a49419a1e3e594ea6c04c2320fa689, type: 3}
