    EffectPos: {x: 0, y: 0}
    EffectScale: 1
    choices:
    - choiceText: "\uB098\uAC04\uB2E4"
      choiceIndex: 3
    - choiceText: "\uB098\uAC00\uAC00\uC9C0 \uC54A\uB294\uB2E4 "
      choiceIndex: 100
    nextIndexOverride: -1
  - id: 3
    speakerName: "\uB098"
    dialogueText: "4\uC6D4\uC774\uC9C0\uB9CC \uBC24\uBC14\uB78C\uC740 \uC544\uC9C1
      \uC300\uC300\uD558\uB2E4 "
    characterIllust: {fileID: 0}
    CharacterPNG: {fileID: 0}
    BackGroundSprit: {fileID: 6919469891305825980, guid: 02a49419a1e3e594ea6c04c2320fa689, type: 3}
    EffectSound: {fileID: 0}
    seVolune: 0
